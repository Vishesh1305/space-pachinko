# Normalize line endings for all text files
* text=auto

# C# scripts
*.cs text diff=csharp

# Unity YAML and JSON assets (Unity writes LF on every platform)
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicsMaterial2D text eol=lf
*.mixer text eol=lf
*.preset text eol=lf
*.spriteatlas text eol=lf
*.spriteatlasv2 text eol=lf
*.inputactions text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.asmdef text eol=lf
*.json text eol=lf

# Plain text
*.md text
*.txt text

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.svg text

# Audio
*.wav binary
*.mp3 binary
*.ogg binary

# Fonts
*.ttf binary
*.otf binary

# Archives
*.zip binary